generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============ TENANT ============

model Complex {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String     @unique
  customDomain String?    @unique
  plan         Plan       @default(STARTER)
  planStatus   PlanStatus @default(ACTIVE)
  timezone     String     @default("America/Argentina/Buenos_Aires")
  logoUrl      String?
  primaryColor String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sports       Sport[]
  courts       Court[]
  branches     Branch[]
  memberships  Membership[]
  customers    Customer[]
  bookings     Booking[]
  tournaments  Tournament[]
  coupons      Coupon[]
  subscription Subscription?
}

model Branch {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  complexId String  @db.ObjectId
  complex   Complex @relation(fields: [complexId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  courts    Court[]
}

// ============ DEPORTES CONFIGURABLES ============

model Sport {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  complexId          String  @db.ObjectId
  complex            Complex @relation(fields: [complexId], references: [id], onDelete: Cascade)
  name               String
  icon               String?
  defaultSlotMinutes Int     @default(60)
  minPlayers         Int?
  maxPlayers         Int?
  allowsTournaments  Boolean @default(true)

  courts      Court[]
  tournaments Tournament[]
}

model Court {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  complexId String  @db.ObjectId
  complex   Complex @relation(fields: [complexId], references: [id], onDelete: Cascade)

  branchId String? @db.ObjectId
  branch   Branch? @relation(fields: [branchId], references: [id])

  sportId String @db.ObjectId
  sport   Sport  @relation(fields: [sportId], references: [id])

  name     String
  isActive Boolean @default(true)

  pricing  PricingRule[]
  bookings Booking[]
  matches  Match[]
}

model PricingRule {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  courtId      String @db.ObjectId
  court        Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek    Int?
  startTime    String
  endTime      String
  pricePerHour Float
}

// ============ USUARIOS Y PERMISOS ============

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  email        String  @unique
  name         String
  phone        String?
  passwordHash String?

  memberships Membership[]

  createdAt DateTime @default(now())
}

model Membership {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  complexId       String    @db.ObjectId
  complex         Complex   @relation(fields: [complexId], references: [id], onDelete: Cascade)
  role            Role
  permissions     Json?
  bookingsCreated Booking[]

  @@unique([userId, complexId])
}

model Customer {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  complexId     String  @db.ObjectId
  complex       Complex @relation(fields: [complexId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  isVip         Boolean @default(false)
  loyaltyPoints Int     @default(0)

  bookings Booking[]

  createdAt DateTime @default(now())
}

// ============ RESERVAS ============

model Booking {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  complexId       String         @db.ObjectId
  complex         Complex        @relation(fields: [complexId], references: [id], onDelete: Cascade)
  courtId         String         @db.ObjectId
  court           Court          @relation(fields: [courtId], references: [id])
  customerId      String?        @db.ObjectId
  customer        Customer?      @relation(fields: [customerId], references: [id])
  createdById     String?        @db.ObjectId
  createdBy       Membership?    @relation(fields: [createdById], references: [id])
  startTime       DateTime
  endTime         DateTime
  status          BookingStatus  @default(PENDING)
  totalPrice      Float
  depositPaid     Float          @default(0)
  paymentMethod   PaymentMethod?
  mpPreferenceId  String?
  mpPaymentId     String?
  couponCode      String?
  discountApplied Float          @default(0)
  notes           String?
  isRecurring     Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([complexId, courtId, startTime])
}

// ============ TORNEOS (PRO) ============

model Tournament {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  complexId       String           @db.ObjectId
  complex         Complex          @relation(fields: [complexId], references: [id], onDelete: Cascade)
  sportId         String           @db.ObjectId
  sport           Sport            @relation(fields: [sportId], references: [id])
  name            String
  format          TournamentFormat
  status          TournamentStatus @default(DRAFT)
  registrationFee Float?
  publicSlug      String           @unique
  coverImageUrl   String?

  teams    TournamentTeam[]
  matches  Match[]
  sponsors Sponsor[]

  createdAt DateTime @default(now())
}

model TournamentTeam {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId     String     @db.ObjectId
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name             String
  players          Json
  paidRegistration Boolean    @default(false)
  seed             Int?

  matchesAsA Match[] @relation("teamA")
  matchesAsB Match[] @relation("teamB")
}

model Match {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String     @db.ObjectId
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        String
  roundOrder   Int        @default(0)

  courtId String? @db.ObjectId
  court   Court?  @relation(fields: [courtId], references: [id])

  scheduledAt DateTime?

  teamAId String?         @db.ObjectId
  teamA   TournamentTeam? @relation("teamA", fields: [teamAId], references: [id])

  teamBId String?         @db.ObjectId
  teamB   TournamentTeam? @relation("teamB", fields: [teamBId], references: [id])

  scoreA Int?
  scoreB Int?

  status MatchStatus @default(SCHEDULED)

  nextMatchId String? @db.ObjectId
}

model Sponsor {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String     @db.ObjectId
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  logoUrl      String?
}

// ============ MARKETING (PRO) ============

model Coupon {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  complexId     String       @db.ObjectId
  complex       Complex      @relation(fields: [complexId], references: [id], onDelete: Cascade)
  code          String
  discountType  DiscountType
  discountValue Float
  isActive      Boolean      @default(true)
  expiresAt     DateTime?
  usesCount     Int          @default(0)
  createdAt     DateTime     @default(now())

  @@unique([complexId, code])
}

// ============ FACTURACIÓN SAAS ============

model Subscription {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  complexId        String     @unique @db.ObjectId
  complex          Complex    @relation(fields: [complexId], references: [id], onDelete: Cascade)
  plan             Plan
  mercadoPagoId    String?
  currentPeriodEnd DateTime?
  status           PlanStatus
}

// ============ ENUMS ============

enum Plan {
  STARTER
  PRO
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Role {
  SUPER_ADMIN
  OWNER
  EMPLOYEE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  MERCADO_PAGO
  TRANSFER
  CASH
}

enum TournamentFormat {
  SINGLE_ELIM
  DOUBLE_ELIM
  ROUND_ROBIN
  GROUPS_KNOCKOUT
  LEAGUE
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  IN_PROGRESS
  FINISHED
}

enum MatchStatus {
  SCHEDULED
  PLAYED
  WALKOVER
}
